# Copie para .env.local e aponte para um Postgres seu.
#
# Na Vercel voce nao precisa preencher nada a mao: em Storage -> Create Database
# (Postgres), a plataforma injeta POSTGRES_URL sozinha no projeto.
#
# Supabase, Neon ou Postgres local tambem servem — use a URL com pooler.
POSTGRES_URL="postgresql://usuario:senha@localhost:5432/dailyplanner"
